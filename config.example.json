{
  "poll": {
    "orgs": ["your-org"],
    "repos": ["owner/specific-repo"],
    "interval_seconds": 600
  },
  "port": 3000,
  "host": "127.0.0.1",
  "workspace_base_path": "~/.claude-patrol/workspaces",
  "work_dir": "~/work",
  "global_terminal_cwd": "~/work",
  "symlink_memory": true,
  "automation": {
    "concurrency": 2
  },
  "repos": {
    "your-org/your-repo": {
      "symlinks": [
        "./path/to/secret-file"
      ],
      "initCommands": [
        "npm install"
      ]
    }
  }
}
